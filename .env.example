# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Rule 5 Compliance: Never commit actual credentials, tokens, or private keys.
# Duplicate this file to '.env' and provide real values for your environment.
# All environment variables must have non-sensitive default/placeholder entries.
# ==============================================================================

# --- Application Runtime ---
NODE_ENV=development
APP_ENV=local
APP_PORT=8080
APP_HOST=localhost
LOG_LEVEL=debug

# --- Security & Secrets (Use strong random strings in .env) ---
# Generate via: openssl rand -base64 32
APP_SECRET=replace-with-a-secure-random-secret
API_KEY_PLACEHOLDER=your-api-key-here

# --- Database / Storage Configuration ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=project_db
DB_USER=project_user
DB_PASSWORD=replace-with-local-db-password

# --- External Service Integrations ---
EXTERNAL_SERVICE_BASE_URL=https://api.example.com/v1
EXTERNAL_SERVICE_TIMEOUT_MS=5000
