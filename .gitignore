# ==============================================================================
# UNIVERSAL GITIGNORE FOR MULTI-LANGUAGE PROJECTS
# Adheres to Rule 5: Zero credentials committed to version control.
# ==============================================================================

# --- Environment & Secret Files ---
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.cert
*.crt
credentials.json
service-account*.json
id_rsa
id_ed25519

# --- Operating System Artifacts ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# --- IDE & Editor Artifacts ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Node.js / JavaScript / TypeScript ---
node_modules/
jspm_packages/
.npm/
.yarn/
*.tsbuildinfo
.eslintcache
.stylelintcache

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Rust ---
/target/
**/*.rs.bk
Cargo.lock.temp

# --- Go ---
/bin/
/pkg/
*.test
*.prof

# --- C / C++ / Native / Desktop ---
*.o
*.obj
*.dll
*.so
*.dylib
*.exe
*.out
*.app
CMakeFiles/
CMakeCache.txt
cmake_install.cmake

# --- Build, Distribution & Cache Directories ---
dist/
build/
out/
bin/
obj/
release/
temp/
tmp/
.cache/
.parcel-cache/
.next/
.nuxt/

# --- Logs & Telemetry ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Testing & Code Coverage ---
coverage/
.nyc_output/
htmlcov/
.tox/
.coverage
.coverage.*
lcov.info

# --- Project Temporary Scratchpad ---
scratch/
*.tmp
